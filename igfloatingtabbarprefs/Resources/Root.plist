<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <!-- MASTER TOGGLE -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>ENABLE TWEAK</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.custom.igfloatingtabbar</string>
            <key>key</key>
            <string>enabled</string>
            <key>label</key>
            <string>Enable Floating TabBar</string>
            <key>PostNotification</key>
            <string>com.custom.igfloatingtabbar/reload</string>
        </dict>

        <!-- FLOATY BAR SPACING & POSITION -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>BAR HEIGHT</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>54</real>
            <key>min</key>
            <real>40</real>
            <key>max</key>
            <real>75</real>
            <key>showValue</key>
            <true/>
            <key>defaults</key>
            <string>com.custom.igfloatingtabbar</string>
            <key>key</key>
            <string>barHeight</string>
            <key>PostNotification</key>
            <string>com.custom.igfloatingtabbar/reload</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>SIDE SPACING (LEFT / RIGHT MARGIN)</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>16</real>
            <key>min</key>
            <real>0</real>
            <key>max</key>
            <real>45</real>
            <key>showValue</key>
            <true/>
            <key>defaults</key>
            <string>com.custom.igfloatingtabbar</string>
            <key>key</key>
            <string>sideMargin</string>
            <key>PostNotification</key>
            <string>com.custom.igfloatingtabbar/reload</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>BOTTOM SPACING (VERTICAL MARGIN)</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>16</real>
            <key>min</key>
            <real>0</real>
            <key>max</key>
            <real>60</real>
            <key>showValue</key>
            <true/>
            <key>defaults</key>
            <string>com.custom.igfloatingtabbar</string>
            <key>key</key>
            <string>bottomMargin</string>
            <key>PostNotification</key>
            <string>com.custom.igfloatingtabbar/reload</string>
        </dict>

        <!-- ICON LAYOUT SPACING -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>ICON INNER SPACING (SIDE PADDING)</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>8</real>
            <key>min</key>
            <real>0</real>
            <key>max</key>
            <real>30</real>
            <key>showValue</key>
            <true/>
            <key>defaults</key>
            <string>com.custom.igfloatingtabbar</string>
            <key>key</key>
            <string>iconSpacing</string>
            <key>PostNotification</key>
            <string>com.custom.igfloatingtabbar/reload</string>
        </dict>

        <!-- COLOR & OPACITY -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>BACKGROUND COLOR (HEX CODE)</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSEditTextCell</string>
            <key>default</key>
            <string>#1A1A1A</string>
            <key>defaults</key>
            <string>com.custom.igfloatingtabbar</string>
            <key>key</key>
            <string>hexColor</string>
            <key>label</key>
            <string>Hex Color:</string>
            <key>placeholder</key>
            <string>#1A1A1A</string>
            <key>PostNotification</key>
            <string>com.custom.igfloatingtabbar/reload</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>BAR OPACITY</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>0.88</real>
            <key>min</key>
            <real>0.1</real>
            <key>max</key>
            <real>1.0</real>
            <key>showValue</key>
            <true/>
            <key>defaults</key>
            <string>com.custom.igfloatingtabbar</string>
            <key>key</key>
            <string>barAlpha</string>
            <key>PostNotification</key>
            <string>com.custom.igfloatingtabbar/reload</string>
        </dict>

        <!-- RESPRING / RELOAD BUTTON -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>APPLY CHANGES</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>action</key>
            <string>respring</string>
            <key>label</key>
            <string>Respring / Apply Settings</string>
        </dict>
    </array>
    <key>title</key>
    <string>IG Floating TabBar</string>
</dict>
</plist>
